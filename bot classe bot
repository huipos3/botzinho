import discord
from discord.ext import commands
from config import TOKEN, mentalist, songs, games
import random

intents = discord.Intents.default()
intents.message_content = True
intents.members = True

bot = commands.Bot(command_prefix='$', intents=intents)

@bot.event
async def on_ready():
    print(f'Estamos logados como {bot.user}')

@bot.command()
async def hello(ctx):
    await ctx.send(f'Olá! eu sou um bot {bot.user}!')

@bot.command()
async def heh(ctx, count_heh = 5):
    await ctx.send("he" * count_heh)

#ADICIONANDO NOVAS FUNCIONALIDADES 

@bot.command()
async def add(ctx, left: int, right: int):
    await ctx.send(left + right)

@bot.command()
async def roll(ctx, dice: str):
    try:
        rolls, limit = map(int, dice.split('d'))
    except Exception:
        await ctx.send('Format has to be in NdN!')
        return
    
    result = ', '.join(str(random.randint(1, limit)) for r in range(rolls))
    await ctx.send(result)

@bot.command()
async def choose(ctx, *choices: str):
    await ctx.send(random.choice(choices))

#UTILIZANDO A CLASSE BOT
@bot.command(aliases=['oi', 'olá', 'eaí'])
async def saudacao(ctx):
    await ctx.send('Eaí! Como vc tá?')

@bot.command()
async def vidente(ctx, *, pergunta):
    await ctx.send(f'**Pergunta:** {pergunta}\n'
               f'**Resposta:** {random.choice(mentalist)}')

@bot.command()
async def spotify(ctx):
    await ctx.send(random.choice(songs))

@bot.command()
async def game(ctx):
    await ctx.send(f'Um jogo que você pode jogar é {random.choice(games)}')

@bot.command()
async def joined(ctx, member: discord.Member):
    await ctx.send(
        f'{member.name} entrou no servidor em '
        f'{discord.utils.format_dt(member.joined_at, style="F")}'
    )

bot.run(TOKEN)
